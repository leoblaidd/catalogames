{
  "name": "catalogames",
  "version": "1.4.0",
  "description": "Catálogo de jogos zerados, com listas e capas",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "author": "Leandro",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.0"
  },
  "productName": "Catalogames",
  "build": {
    "appId": "com.leandro.catalogame",
    "productName": "Catalogames",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Catalogames",
      "uninstallDisplayName": "Catalogames",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ],
      "artifactName": "Catalogames-Instalador-${version}.${ext}"
    },
    "publish": null
  }
}
